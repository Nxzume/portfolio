{
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-cms-content.mjs && tsc -b && vite build && npm run build:ssr && npm run prerender",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "preview": "vite preview",
    "cms:migrate": "node cms/migrate.mjs"
  }
}
